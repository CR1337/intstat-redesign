{
    "table_name": "daten",
    "description": "Tabelle für die Speicherung von statistischen Einzelwerten (Zeitreihen) zu Ländern und Indikatoren.",
    "columns": [
        {
            "name": "datum",
            "type": "DATE",
            "not_null": true,
            "default": "'2000-01-01'",
            "description": "Datum, an dem der Wert erhoben oder veröffentlicht wurde."
        },
        {
            "name": "wert",
            "type": "DOUBLE",
            "not_null": true,
            "default": 0,
            "description": "Erfasster numerischer Wert für das jeweilige Land und den Indikator am angegebenen Datum."
        },
        {
            "name": "berechnet",
            "type": "BOOLEAN",
            "not_null": true,
            "default": 0,
            "description": "Gibt an, ob der Wert berechnet wurde."
        }
    ],
    "foreign_keys": [
        {
            "name": "laender",
            "references": "laender",
            "min_1": false,
            "description": "Verweis auf das Land, für das der Wert gilt.",
            "not_null": true,
            "diagram_description": "f\u00fcr Land"
        },
        {
            "name": "indikatoren",
            "references": "indikatoren",
            "min_1": false,
            "description": "Verweis auf den Indikator, zu dem der Wert gehört.",
            "not_null": true,
            "diagram_description": "f\u00fcr Indikator"
        }
    ],
    "unique_sets": [
        [
            "laender_id",
            "indikatoren_id"
        ]
    ],
    "attribute_lists": [
        {
            "name": "downloadquellen",
            "zo_table": "downloadquellen_zo",
            "references": "quellen"
        },
        {
            "name": "lizenzen",
            "zo_table": "lizenzen_zo",
            "references": "lizenzen"
        },
        {
            "name": "metadaten",
            "zo_table": "metadaten_zo",
            "references": "metadaten"
        },
        {
            "name": "quellen",
            "zo_table": "quellen_zo",
            "references": "quellen"
        },
        {
            "name": "ugl",
            "zo_table": "ugl_zo",
            "references": "ugl_"
        }
    ],
    "is_zo": false
}